{
  "manifest_version": 3,
  "name": "GitPulse",
  "version": "2.0",
  "description": "GitPulse — Precision GitHub Contribution Engine created by Yatharth Nagpal.",
  "author": "Yatharth Nagpal",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open GitPulse",
    "default_icon": "gitpulse_logo.png"
  },
  "icons": {
    "128": "gitpulse_logo.png"
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}


